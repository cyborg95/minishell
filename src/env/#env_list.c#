#include "../../includes/minishell.h"

static char	*env_to_str(t_env *env)
{
	char	*tmp1;
	char	*tmp2;

	tmp1 = strjoin(env->key, "=");
	if (!tmp1)
		return (NULL);
	tmp2 = strjoin(tmp1, env->value);
	free(tmp1);
	return (tmp2);
}

char	**env_list_to_array(t_env *env)
{
	char	**arr;
	int		i;
	int		count;

	count = env_size(env);
	arr = malloc(sizeof(char *) * (count + 1));
	if (!arr)
		return (NULL);
	i = 0;
	while (env)
	{
		arr[i] = env_to_str(env);
		if (!arr[i])
			return (NULL);
		env = env->next;
		i++;
	}
	arr[i] = NULL;
	return (arr);
}

static int	get_len(long nb)
{
	int	len;

	len = (nb <= 0);
	while (nb)
	{
		nb /= 10;
		len++;
	}
	return (len);
}

char	*ft_itoa_remix(int n)
{
	long	nb;
	int		len;
	char	*str;

	nb = n;
	len = get_len(nb);
	str = malloc (sizeof(char) * (len + 1));
	if (!str)
		return (NULL);
	str[len] = '\0';
	if (nb == 0)
		str[0] = '0';
	if (nb < 0)
	{
		str[0] = '-';
		nb = -nb;
	}
	while (nb > 0)
	{
		str[--len] = (nb % 10) + '0';
		nb /= 10;
	}
	return (str);
}
